# Normalize line endings in the repo; check out with the platform's native endings.
* text=auto

# Windows-only tooling keeps CRLF.
*.sln   text eol=crlf
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

*.cs    text diff=csharp
*.xaml  text
*.csproj text
*.pubxml text
*.xshd  text
*.md    text diff=markdown
*.yml   text

*.png   binary
*.ico   binary
*.jpg   binary
*.dll   binary
*.exe   binary
