<Window x:Class="Prompty.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Prompty update" Width="620" Height="520" ResizeMode="CanResizeWithGrip" MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource PanelBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Text="A new version of Prompty is available" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" x:Name="SubHeading" Foreground="{StaticResource MutedText}" Margin="0,4,0,12" TextWrapping="Wrap" />

        <Border Grid.Row="2" Background="{StaticResource EditorBrush}" CornerRadius="6" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="WHAT'S NEW" Style="{StaticResource PanelHeader}" Margin="12,10,12,0" />
                <TextBox x:Name="Notes" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                         Background="Transparent" FontSize="13" Padding="8,4,8,8" />
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="1" Visibility="Collapsed" />
            <TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" x:Name="MuteButton" Click="Mute_Click"
                    ToolTip="No more update prompts until a new major version is released. You can still check manually in Settings." />
            <Button DockPanel.Dock="Right" x:Name="UpdateButton" Content="Update now" Style="{StaticResource AccentButtonStyle}"
                    MinWidth="120" Margin="8,0,0,0" Click="Update_Click" IsDefault="True" />
            <Button DockPanel.Dock="Right" x:Name="SkipButton" Content="Skip this version" Click="Skip_Click"
                    ToolTip="Don't prompt for this version again; you'll be asked when the next one comes out" />
        </DockPanel>
    </Grid>
</Window>
