<Application x:Class="Prompty.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources RequestedTheme="Dark" />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PanelBrush" Color="#1E1F24" />
            <SolidColorBrush x:Key="EditorBrush" Color="#16171B" />
            <SolidColorBrush x:Key="CardBrush" Color="#25272E" />
            <SolidColorBrush x:Key="BorderBrushSubtle" Color="#33363F" />
            <SolidColorBrush x:Key="MutedText" Color="#9CA0AB" />
            <SolidColorBrush x:Key="AccentText" Color="#D9A27A" />
            <SolidColorBrush x:Key="Good" Color="#6CC57C" />
            <SolidColorBrush x:Key="Bad" Color="#E06C75" />

            <Style x:Key="PanelHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
