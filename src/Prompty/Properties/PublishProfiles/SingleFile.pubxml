<?xml version="1.0" encoding="utf-8"?>
<!--
  One self-contained Prompty.exe: the .NET runtime, WPF, ASP.NET Core (MCP host), every NuGet
  dependency, the native WPF libraries and the debug symbols are all packed into the executable.
  Used by build.ps1 and CI:  dotnet publish src/Prompty -p:PublishProfile=SingleFile
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Bundle native DLLs (wpfgfx, PresentationNative, D3DCompiler...) and any content files too. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Precompiled code for faster startup. Trimming is not supported for WPF, so it stays off. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Symbols inside the exe (no .pdb next to it); only English satellite resources. -->
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\</PublishDir>
  </PropertyGroup>
</Project>
